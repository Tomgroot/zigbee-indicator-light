(module easyeda2kicad:TESTPAD_BOOT (layer B.Cu) (tedit 0)
	(descr "Two bare 1.5 mm pads at 2.54 mm pitch: short them to enter download mode. No part, no paste.")
	(attr smd)
	(fp_text reference REF** (at 0.000 -2.000) (layer B.Fab)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_text value TESTPAD_BOOT (at 0.000 2.000) (layer B.Fab)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(pad 1 smd circle (at -1.27 0.00 0.00) (size 1.500 1.500) (layers B.Cu B.Mask))
	(pad 2 smd circle (at 1.27 0.00 0.00) (size 1.500 1.500) (layers B.Cu B.Mask))
)
